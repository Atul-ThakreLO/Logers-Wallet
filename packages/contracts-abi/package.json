{
  "name": "@logers/contracts-abi",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./LogersAccount": "./src/generated/LogersAccount.abi.ts",
    "./LogersAccountFactory": "./src/generated/LogersAccountFactory.abi.ts",
    "./LogersPaymaster": "./src/generated/LogersPaymaster.abi.ts",
    "./LogersPriceOracle": "./src/generated/LogersPriceOracle.abi.ts"
  },
  "scripts": {
    "build": "echo 'contracts-abi: source package, no build needed'",
    "generate": "bun ../../tooling/scripts/extract-abis.ts",
    "lint": "biome check src/",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf src/generated/*.ts"
  },
  "devDependencies": {
    "@logers/typescript-config": "workspace:*",
    "typescript": "^5.5.3"
  }
}
