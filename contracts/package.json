{
  "name": "logers-contracts",
  "private": true,
  "scripts": {
    "build": "forge build",
    "test": "forge test -vvv",
    "coverage": "forge coverage --report lcov",
    "format": "forge fmt",
    "lint": "forge fmt --check",
    "clean": "forge clean",
    "snapshot": "forge snapshot",
    "deploy:local": "forge script script/Deploy.s.sol --rpc-url http://localhost:8545 --broadcast",
    "deploy:base-sepolia": "forge script script/Deploy.s.sol --rpc-url $BASE_SEPOLIA_RPC_URL --broadcast --verify"
  }
}
