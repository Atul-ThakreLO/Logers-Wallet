{
  "name": "@logers/sdk",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./passkey": {
      "import": "./dist/passkey/index.js",
      "types": "./dist/passkey/index.d.ts"
    },
    "./chain": {
      "import": "./dist/chain/index.js",
      "types": "./dist/chain/index.d.ts"
    },
    "./graph": {
      "import": "./dist/graph/index.js",
      "types": "./dist/graph/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@logers/contracts-abi": "workspace:*",
    "@logers/utils": "workspace:*",
    "@logers/wagmi-config": "workspace:*",
    "viem": "^2.17.0",
    "zod": "^3.23.8",
    "@simplewebauthn/browser": "^10.0.0",
    "@simplewebauthn/types": "^10.0.0"
  },
  "devDependencies": {
    "@logers/typescript-config": "workspace:*",
    "typescript": "^5.5.3"
  }
}
